# Copy to /etc/business-analysis-market/market-analysis.env and set mode 0640.
# Never commit real tokens or paste them into deployment logs.
MARKET_ANALYSIS_HERMES_ENABLED=1
MARKET_ANALYSIS_HERMES_BASE_URL=http://192.168.50.2:55501/v1
MARKET_ANALYSIS_HERMES_API_KEY=
MARKET_ANALYSIS_HERMES_TIMEOUT_SECONDS=180
# 阿里百炼（Model Studio）Anthropic 兼容端点，按量计费，华北 2（北京）。
# 只能填到 /apps/anthropic，不得追加 /v1；该端点只提供 /v1/messages，无 /v1/models。
# 业务空间专属域名：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/apps/anthropic
BAILIAN_ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
ANTHROPIC_AUTH_TOKEN=
# Keep provider credentials separate. Never fill these in the tracked template.
# DASHSCOPE_API_KEY 为百炼 API Key（sk- 开头），是 qwen3.8-max 路由的首选凭据。
DASHSCOPE_API_KEY=
BAILIAN_API_KEY=
KIMI_CODE_API_KEY=
DEEPSEEK_AUTH_TOKEN=
MARKET_ANALYSIS_KIMI_TIMEOUT_SECONDS=900
ANTHROPIC_MODEL=qwen3.8-max
ANTHROPIC_DEFAULT_OPUS_MODEL=qwen3.8-max
ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3.8-max
ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3.8-max
CLAUDE_CODE_SUBAGENT_MODEL=qwen3.8-max
# qwen3.8-max 上下文 1,000,000；思考模式下最大输入 983,616。
# 压缩窗口沿用已在生产验证的 786432，不靠模型名 [1m] 后缀开启长上下文。
CLAUDE_CODE_AUTO_COMPACT_WINDOW=786432
CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000
CLAUDE_CODE_DISABLE_1M_CONTEXT=0
MARKET_ANALYSIS_QWEN_CONTEXT_TOKENS=1000000
# 四角色优先 Qwen；通道不可用时在本阶段剩余时间/预算内仅一次 DeepSeek Flash 接替。
MARKET_ANALYSIS_MODEL=qwen3.8-max
MARKET_ANALYSIS_PRIMARY_MODEL=qwen3.8-max
MARKET_ANALYSIS_REPAIR_MODEL=qwen3.8-max
MARKET_ANALYSIS_ESCALATION_MODEL=qwen3.8-max
MARKET_ANALYSIS_SOURCE_SCOUT_ENABLED=1
MARKET_ANALYSIS_SOURCE_SCOUT_MODEL=qwen3.8-max
# 思考深度。qwen3.8-max 合法档位为 xhigh/medium/low，百炼会把 high 与 max 映射为 xhigh。
MARKET_ANALYSIS_REASONING_EFFORT=medium
MARKET_ANALYSIS_SOURCE_SCOUT_MAX_TURNS=25
MARKET_ANALYSIS_SOURCE_SCOUT_MAX_BUDGET_USD=3.2
MARKET_ANALYSIS_SOURCE_SCOUT_TIMEOUT_SECONDS=900
MARKET_ANALYSIS_ZHIHU_ENABLED=1
ZHIHU_ACCESS_SECRET=
MARKET_ANALYSIS_ZHIHU_MAX_QUERIES=4
MARKET_ANALYSIS_ZHIHU_MAX_RESULTS=12
MARKET_ANALYSIS_ZHIHU_TIMEOUT_SECONDS=20
MARKET_ANALYSIS_MAX_TURNS=80
MARKET_ANALYSIS_MAX_BUDGET_USD=8
MARKET_ANALYSIS_REPAIR_MAX_TURNS=40
MARKET_ANALYSIS_REPAIR_MAX_BUDGET_USD=3
MARKET_ANALYSIS_ESCALATION_MAX_TURNS=45
MARKET_ANALYSIS_ESCALATION_MAX_BUDGET_USD=6
MARKET_ANALYSIS_MAX_REPAIR_ATTEMPTS=2
MARKET_ANALYSIS_POST_VERIFY_REPAIR_ATTEMPTS=1
MARKET_ANALYSIS_MIN_QUALITY_SCORE=9.0
MARKET_ANALYSIS_REQUIRE_PRODUCT_RESEARCH=1
MARKET_ANALYSIS_TIMEOUT_SECONDS=3600
MARKET_ANALYSIS_SOURCE_TIMEOUT_SECONDS=25
MARKET_ANALYSIS_SOURCE_MAX_BYTES=33554432
MARKET_ANALYSIS_SOURCE_VERIFY_WORKERS=4
MARKET_ANALYSIS_BUSINESS_YEAR=2026
CLAUDE_CODE_EFFORT_LEVEL=medium
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
API_TIMEOUT_MS=3000000
AI_READONLY_TOKEN=

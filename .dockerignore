!market-analysis.html
!personnel-management.html
!tax-calculator.html
!zhituo-analysis.html
# Last-match exclusions protect runtime data under approved directories.
**/__pycache__/**
**/*sync-conflict*
**/.venv/**
**/.venv.*/**
**/venv/**
**/venv.*/**
backend/logs/**
backend/market_analysis_data/**
**/.env*
**/.*_env
**/*.db*
**/*.csv
**/*.xlsx
**/*.sqlite*
